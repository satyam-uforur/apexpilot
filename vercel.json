{
  "version": 2,
  "framework": null,
  "buildCommand": "cd client && npm run build",
  "installCommand": "npm install && cd server && npm install && cd ../client && npm install",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
}
